{
  "name": "MinsEPUBviewer",
  "version": "0.1.6",
  "description": "Mins Reader: shared EPUB, PDF and Markdown reader for Windows and Android.",
  "author": "Mins",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:vendor": "esbuild src/vendor/toastui-entry.js --bundle --minify --legal-comments=external --format=iife --outfile=web/vendor/toastui-editor-bundle.js",
    "build": "node scripts/release.cjs",
    "build:pc-dir": "npm run build:vendor && electron-builder --win dir",
    "dev": "npm run build:vendor && node scripts/dev-server.js",
    "desktop": "npm run build:vendor && electron .",
    "test": "node --test",
    "test:reader": "electron scripts/smoke-reader.cjs",
    "build:mobile": "npm run build:vendor && node scripts/build-mobile.js",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "node scripts/release.cjs android",
    "android:install": "node scripts/install-android.js",
    "test:pdf": "electron scripts/smoke-pdf.cjs",
    "test:documents": "electron scripts/smoke-documents.cjs",
    "release": "node scripts/release.cjs",
    "release:pc": "node scripts/release.cjs pc",
    "release:android": "node scripts/release.cjs android"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@ohah/hwpjs": "0.1.0-rc.10",
    "epubjs": "^0.3.93",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@toast-ui/editor": "^3.2.2",
    "@xmldom/xmldom": "0.9.8",
    "cfb": "^1.2.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.mins.epubviewer",
    "productName": "Mins Reader",
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "src/**/*",
      "!src/vendor/**",
      "!src/platform/android.js",
      "package.json",
      "!node_modules/**/*",
      "node_modules/epubjs/dist/epub.min.js",
      "node_modules/epubjs/license",
      "node_modules/jszip/dist/jszip.min.js",
      "node_modules/jszip/LICENSE.markdown",
      "node_modules/pdfjs-dist/LICENSE",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdfjs-dist/web/pdf_viewer.mjs",
      "node_modules/pdfjs-dist/web/pdf_viewer.css",
      "node_modules/pdfjs-dist/web/images/**/*",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*",
      "node_modules/pdfjs-dist/iccs/**/*",
      "node_modules/mammoth/mammoth.browser.min.js",
      "node_modules/mammoth/LICENSE",
      "node_modules/@ohah/hwpjs/package.json",
      "node_modules/@ohah/hwpjs/LICENSE",
      "node_modules/@ohah/hwpjs/dist/index.js",
      "node_modules/@ohah/hwpjs/dist/hwpjs.win32-x64-msvc.node"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB 전자책"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF 문서"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 문서"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir",
        "nsis"
      ],
      "artifactName": "MinsReader_ver${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/@ohah/hwpjs/dist/*.node"
    ]
  }
}
