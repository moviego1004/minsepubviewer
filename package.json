{
  "name": "MinsEPUBviewer",
  "version": "0.1.0",
  "description": "Shared EPUB and Markdown reader for Windows and Android.",
  "author": "Mins",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:vendor": "esbuild src/vendor/toastui-entry.js --bundle --minify --legal-comments=external --format=iife --outfile=web/vendor/toastui-editor-bundle.js",
    "build": "npm run build:vendor && electron-builder --win dir",
    "dev": "npm run build:vendor && node scripts/dev-server.js",
    "desktop": "npm run build:vendor && electron .",
    "test": "node --test",
    "test:reader": "electron scripts/smoke-reader.cjs",
    "build:mobile": "npm run build:vendor && node scripts/build-mobile.js",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/build-android.js",
    "android:install": "node scripts/install-android.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@toast-ui/editor": "^3.2.2",
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.mins.epubviewer",
    "productName": "Mins EPUB Viewer",
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "src/**/*",
      "node_modules/epubjs/**/*",
      "node_modules/jszip/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB 전자책"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 문서"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir",
        "nsis"
      ],
      "artifactName": "MinsEPUBViewer-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    }
  }
}
